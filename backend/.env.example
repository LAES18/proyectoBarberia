# Backend API
PORT=5002
NODE_ENV=production

# Use a long, unique random value. Example generation:
# openssl rand -base64 48
JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET

# SQLite file path. The service user must be able to write to its directory.
DATABASE_PATH=/var/lib/barberia/database.sqlite

# Used only to create the first administrator when the database has no admin.
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_FULL_NAME=Administrador
ADMIN_PASSWORD=REPLACE_WITH_A_UNIQUE_PASSWORD_OF_AT_LEAST_16_CHARACTERS
