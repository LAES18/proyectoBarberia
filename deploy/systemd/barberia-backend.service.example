[Unit]
Description=Barberia Backend API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=barberia
Group=barberia
WorkingDirectory=/opt/barberia/backend
EnvironmentFile=/etc/barberia/backend.env
ExecStart=/usr/bin/node server.js
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
